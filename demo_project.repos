# The core this project builds on, imported into a core workspace of its own
# (README.md, The workspaces):
#
#   vcs import --recursive src < demo_project.repos
#
# version is a core tag, the core this project's tests passed on. v0.1.0 has
# CHO_ROBOT_CONFIG_ADDITIONS, mujoco_world and mujoco_plugins, which
# demo_bringup uses. The url is https, so a clone needs no GitHub SSH key.
repositories:
  cho_robot_project:
    type: git
    url: https://github.com/chohh7391/cho_robot_project.git
    version: v0.1.0
