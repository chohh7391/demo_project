<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_tasks</name>
  <version>0.1.0</version>
  <description>The demo project's task trees, registered with cho_task_manager.</description>
  <maintainer email="chohh7391@gmail.com">Hyunho Cho</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>cho_task_manager</exec_depend>
  <!-- Sourcing it adds sine_joint_controller to the registry the tree reads. -->
  <exec_depend>demo_bringup</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
